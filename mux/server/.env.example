# Web app (CORS origins as a JSON list; WEB_URL is where GitHub connect returns to)
CORS_ORIGINS=["http://localhost:3000"]
WEB_URL=http://localhost:3000
# Token Factory
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=
MODEL_LIGHTNING=
MODEL_SUPER=
MODEL_ULTRA=
# Nebius Sandboxes
SANDBOX_API_KEY=
SANDBOX_BASE_URL=
# The uuid printed by scripts/import_sandbox_image.py
SANDBOX_IMAGE=
# Tavily
TAVILY_API_KEY=
# Supabase
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Local development only: accept tokens without checking the signature. Never in production.
ALLOW_UNVERIFIED_TOKENS=false
# Postgres: Supabase in production; locally the docker-compose one:
# DATABASE_URL=postgresql+asyncpg://mux:mux@localhost:5433/mux
DATABASE_URL=
# Tests only; the name must contain "test" (tests/conftest.py wipes it)
TEST_DATABASE_URL=postgresql+asyncpg://mux:mux@localhost:5433/mux_test
# GitHub OAuth (export)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The OAuth app's callback: <server>/api/github/callback
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
